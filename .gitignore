# Compiled object files
*.o
*.obj

# Compiled binaries (no extension, produced by gcc)
src/csr_convert
test/csr_convert
test/test_csr
*.out
build/*

# Large datasets and raw graph files
graphs/**/*.edgelist
graphs/**/*.txt
gplus/

# (Optional) If you want to commit small test graphs, uncomment below:
# !graphs/sample_graph.txt

# Editor/OS junk (optional but common)
.vscode/
*.swp
.DS_Store

# Compiled executables (Windows)
*.exe

# Profiling data and large binary reports
gmon.out
*.ncu-rep
results/profiling/
